<div class="application-selector mc-dropdown">
  <details class="mc-dropdown-details">
    <summary class="mc-dropdown-trigger">
      <span><%= MissionControl::Jobs::Current.application.name %></span>
      <span class="mc-dropdown-chevron" aria-hidden="true">▾</span>
    </summary>

    <div class="mc-dropdown-menu">
      <% selectable_applications.each do |application| %>
        <%= link_to application.name, application_queues_path(application, server_id: nil), class: "mc-dropdown-item" %>
      <% end %>
    </div>
  </details>
</div>
