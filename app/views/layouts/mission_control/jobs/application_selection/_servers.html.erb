<% if application.servers.many? %>
  <div class="server-selector mc-segmented-control" role="group" aria-label="Job servers">
    <% application.servers.each do |server| %>
      <%= link_to server.name, application_queues_path(application, server_id: server),
        class: class_names("mc-segment", "is-active" => selected_server?(server)) %>
    <% end %>
  </div>
<% end %>
