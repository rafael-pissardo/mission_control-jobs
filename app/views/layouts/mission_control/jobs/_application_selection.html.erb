<nav class="mc-header-bar" aria-label="Application navigation">
  <div class="mc-header-start">
    <% if defined?(main_app.root_path) %>
      <%= link_to main_app.root_path, class: "mc-back-link" do %>
        <span aria-hidden="true">←</span> Back to app
      <% end %>
    <% end %>
  </div>

  <div class="mc-header-brand">
    <span class="mc-brand-mark" aria-hidden="true">◆</span>
    <span class="mc-brand-text">Mission Control</span>
  </div>

  <div class="mc-header-end">
    <%= render "layouts/mission_control/jobs/application_selection/servers", application: @application %>
    <%= render "layouts/mission_control/jobs/application_selection/applications" if selectable_applications.any? %>
  </div>
</nav>
