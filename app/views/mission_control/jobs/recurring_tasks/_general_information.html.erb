<dl class="mc-kv-grid">
  <% if recurring_task.job_class_name.present? %>
    <div class="mc-kv-item">
      <dt>Job class</dt>
      <dd><%= recurring_task.job_class_name %></dd>
    </div>

    <div class="mc-kv-item">
      <dt>Arguments</dt>
      <dd><div class="mc-code-inline is-family-monospace"><%= recurring_task.arguments.join(",") %></div></dd>
    </div>
  <% elsif recurring_task.command.present? %>
    <div class="mc-kv-item">
      <dt>Command</dt>
      <dd><div class="mc-code-inline is-family-monospace"><%= recurring_task.command %></div></dd>
    </div>
  <% end %>

  <div class="mc-kv-item">
    <dt>Schedule</dt>
    <dd><%= recurring_task.schedule %></dd>
  </div>
  <% if recurring_task.queue_name.present? %>
    <div class="mc-kv-item">
      <dt>Queue</dt>
      <dd><%= recurring_task.queue_name %></dd>
    </div>
  <% end %>
  <% if recurring_task.priority.present? %>
    <div class="mc-kv-item">
      <dt>Priority</dt>
      <dd><%= recurring_task.priority %></dd>
    </div>
  <% end %>
</dl>
