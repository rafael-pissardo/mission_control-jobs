<div class="mc-table-wrapper">
  <table class="recurring-tasks table jobs mc-table is-fullwidth">
    <thead>
      <tr>
        <th scope="col"></th>
        <th scope="col">Job</th>
        <th scope="col">Schedule</th>
        <th scope="col">Last enqueued</th>
        <th scope="col">Next</th>
        <th scope="col"><span class="is-sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "mission_control/jobs/recurring_tasks/recurring_task", collection: @recurring_tasks %>
    </tbody>
  </table>
</div>
