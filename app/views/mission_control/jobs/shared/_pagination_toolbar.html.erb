<nav class="mc-pagination" role="navigation" aria-label="pagination">
  <span class="mc-pagination-status">
    Page <%= page.index %> of <%= page.pages_count || "…" %>
  </span>
  <div class="mc-pagination-controls">
    <%= link_to "First", url_for(page: 1, **filter_param), class: "mc-pagination-btn pagination-previous", disabled: page.first? %>
    <%= link_to "Previous", url_for(page: page.previous_index, **filter_param), class: "mc-pagination-btn pagination-previous", disabled: page.first? %>
    <%= link_to "Next", url_for(page: page.next_index, **filter_param), class: "mc-pagination-btn pagination-next", disabled: page.last? %>
    <%= link_to "Last", url_for(page: page.pages_count, **filter_param), class: "mc-pagination-btn pagination-next", disabled: page.last? %>
  </div>
</nav>
