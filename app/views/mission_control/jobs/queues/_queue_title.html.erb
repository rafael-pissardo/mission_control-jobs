<div class="mc-detail-header">
  <div class="mc-detail-header-title">
    <%= queue.name %>
    <% if queue.paused? %>
      <span class="mc-tag mc-tag--warning">Paused</span>
    <% end %>
  </div>

  <% if queue_pausing_supported? %>
    <div class="mc-detail-header-actions">
      <%= render "mission_control/jobs/queues/actions", queue: queue %>
    </div>
  <% end %>
</div>

<p class="mc-meta"><%= pluralize queue.size, "pending job" %></p>
