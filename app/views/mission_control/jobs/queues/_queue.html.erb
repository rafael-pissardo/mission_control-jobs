<tr class="queue">
  <td>
    <%= link_to queue.name, application_queue_path(@application, queue), class: "mc-job-link" %>
    <% if queue.paused? %>
      <span class="mc-tag mc-tag--warning ml-2">Paused</span>
    <% end %>
  </td>
  <td>
    <%= queue.size %>
  </td>
  <td class="pr-0">
    <% if queue_pausing_supported? %>
      <%= render "mission_control/jobs/queues/actions", queue: queue %>
    <% end %>
  </td>
</tr>
