<div class="mc-list-secondary">
  <%= link_to job.queue_name, application_queue_path(@application, job.queue), class: "mc-list-link mc-list-link--subtle" %>
</div>

<div class="mc-list-secondary">
  <div class="mc-code-inline"><%= job.blocked_by %></div>
  <% if job.blocked_until %>
    <div class="mc-meta">Expires <%= bidirectional_time_distance_in_words_with_title(job.blocked_until) %></div>
  <% end %>
</div>

<div class="mc-list-actions">
  <%= render "mission_control/jobs/jobs/blocked/actions", job: job %>
</div>
