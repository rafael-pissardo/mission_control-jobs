<div class="filter mc-filter-bar">
  <%= form_for :filter, url: application_jobs_path(MissionControl::Jobs::Current.application, jobs_status), method: :get,
    html: { class: "mc-filter-form" },
    data: { controller: "form", action: "input->form#debouncedSubmit" } do |form| %>

    <div class="mc-filter-fields">
      <div class="mc-field">
        <%= form.label :job_class_name, class: "mc-label" %>
        <%= form.text_field :job_class_name, value: @job_filters[:job_class_name], class: "mc-input", list: "job-classes", placeholder: "Filter by job class...", autocomplete: "off" %>
      </div>

      <div class="mc-field">
        <%= form.label :queue_name, class: "mc-label" %>
        <%= form.text_field :queue_name, value: @job_filters[:queue_name], class: "mc-input", list: "queue-names", placeholder: "Filter by queue name...", autocomplete: "off" %>
      </div>

      <% if jobs_status == "finished" %>
        <div class="mc-field">
          <%= form.label :finished_at_start, class: "mc-label" %>
          <%= form.datetime_field :finished_at_start, value: @job_filters[:finished_at]&.begin, class: "mc-input", placeholder: "Finished from" %>
        </div>

        <div class="mc-field">
          <%= form.label :finished_at_end, class: "mc-label" %>
          <%= form.datetime_field :finished_at_end, value: @job_filters[:finished_at]&.end, class: "mc-input", placeholder: "Finished to" %>
        </div>
      <% end %>

      <%= hidden_field_tag :server_id, MissionControl::Jobs::Current.server.id %>

      <datalist id="job-classes" class="is-hidden">
        <% job_class_names.each do |job_class_name| %>
          <option value="<%= job_class_name %>"></option>
        <% end %>
      </datalist>

      <datalist id="queue-names" class="is-hidden">
        <% queue_names.each do |queue_name| %>
          <option value="<%= queue_name %>"></option>
        <% end %>
      </datalist>

      <div class="mc-filter-actions">
        <%= link_to "Clear", application_jobs_path(MissionControl::Jobs::Current.application, jobs_status, job_class_name: nil, queue_name: nil, finished_at: nil..nil), class: "mc-button mc-button--ghost" %>
      </div>
    </div>
  <% end %>
</div>
