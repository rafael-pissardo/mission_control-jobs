<div class="mc-detail-header">
  <div class="mc-detail-header-title">
    <%= job_title(job) %>
    <span class="<%= modifier_for_status(job.status) %>"><%= job.status %></span>
  </div>

  <div class="mc-detail-header-actions buttons is-right">
    <% if job.failed? %>
      <%= render "mission_control/jobs/jobs/failed/actions", job: job %>
    <% end %>
    <% if job.blocked? %>
      <%= render "mission_control/jobs/jobs/blocked/actions", job: job %>
    <% end %>
    <% if job.scheduled? %>
      <%= render "mission_control/jobs/jobs/scheduled/actions", job: job %>
    <% end %>
  </div>
</div>
