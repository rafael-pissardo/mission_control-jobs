<%# locals: (application:, job:) %>

<div class="backtrace-toggle-selector mc-segmented-control mc-segmented-control--compact">
  <%= link_to "Clean", application_job_path(application, job.job_id, clean_backtrace: true),
    class: class_names("mc-segment", "backtrace-clean-link", "is-active" => clean_backtrace?) %>
  <%= link_to "Full", application_job_path(application, job.job_id, clean_backtrace: false),
    class: class_names("mc-segment", "backtrace-full-link", "is-active" => !clean_backtrace?) %>
</div>
