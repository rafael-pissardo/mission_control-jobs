<div class="buttons is-right">
  <%= button_to "Run now", application_job_dispatch_path(@application, job.job_id), class: "mc-button mc-button--warning" %>
  <%= button_to "Discard", application_job_discard_path(@application, job.job_id), class: "mc-button mc-button--danger",
    form: { data: { turbo_confirm: "This will delete the job and can't be undone. Are you sure?" } } %>
</div>
