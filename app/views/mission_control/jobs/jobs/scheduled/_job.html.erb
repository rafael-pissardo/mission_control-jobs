<td><%= link_to job.queue_name, application_queue_path(@application, job.queue), class: "mc-job-link" %></td>
<td>
  <%= bidirectional_time_distance_in_words_with_title(job.scheduled_at) %>
  <% if job_delayed?(job) %>
    <span class="mc-tag mc-tag--danger ml-2">delayed</span>
  <% end %>
</td>
<td class="pr-0">
  <%= render "mission_control/jobs/jobs/scheduled/actions", job: job %>
</td>
