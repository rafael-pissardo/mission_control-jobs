<dl class="mc-kv-grid">
  <div class="mc-kv-item">
    <dt>Arguments</dt>
    <dd>
      <div class="mc-code-inline is-family-monospace">
        <%= job_arguments(job) %>
      </div>
    </dd>
  </div>
  <div class="mc-kv-item">
    <dt>Job id</dt>
    <dd><%= job.job_id %></dd>
  </div>
  <div class="mc-kv-item">
    <dt>Queue</dt>
    <dd>
      <span class="mc-tag mc-tag--neutral">
        <%= link_to job.queue_name, application_queue_path(@application, job.queue), class: "mc-job-link" %>
      </span>
    </dd>
  </div>
  <div class="mc-kv-item">
    <dt>Enqueued</dt>
    <dd>
      <%= time_distance_in_words_with_title(job.enqueued_at.to_datetime) %> ago
    </dd>
  </div>
  <% if job.scheduled? %>
    <div class="mc-kv-item">
      <dt>Scheduled</dt>
      <dd>
        <%= bidirectional_time_distance_in_words_with_title(job.scheduled_at) %>
        <% if job_delayed?(job) %>
          <span class="mc-tag mc-tag--danger ml-2">delayed</span>
        <% end %>
      </dd>
    </div>
  <% end %>
  <% if job.failed? %>
    <div class="mc-kv-item">
      <dt>Failed</dt>
      <dd>
        <%= time_distance_in_words_with_title(job.failed_at) %> ago
      </dd>
    </div>
  <% end %>
  <% if job.finished_at.present? %>
    <div class="mc-kv-item">
      <dt>Finished</dt>
      <dd>
        <%= time_distance_in_words_with_title(job.finished_at) %> ago
      </dd>
    </div>
    <div class="mc-kv-item">
      <dt>Duration</dt>
      <dd>
        <%= job.duration.round(3) %> seconds
      </dd>
    </div>
  <% end %>
  <% if job.worker_id.present? %>
    <div class="mc-kv-item">
      <dt>Processed by</dt>
      <dd>
        <%= link_to "worker #{job.worker_id}", application_worker_path(@application, job.worker_id), class: "mc-job-link" %>
      </dd>
    </div>
  <% end %>
</dl>
