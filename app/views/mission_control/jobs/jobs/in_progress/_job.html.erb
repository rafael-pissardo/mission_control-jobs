<div class="mc-list-secondary">
  <%= link_to job.queue_name, application_queue_path(@application, job.queue), class: "mc-list-link mc-list-link--subtle" %>
</div>

<div class="mc-list-secondary">
  <% if job.worker_id %>
    <%= link_to "Worker #{job.worker_id}", application_worker_path(@application, job.worker_id), class: "mc-list-link mc-list-link--subtle" %>
  <% else %>
    <span class="mc-meta">—</span>
  <% end %>
</div>

<div class="mc-list-secondary mc-list-secondary--muted">
  <%= job.started_at ? time_distance_in_words_with_title(job.started_at) : "(Finished)" %>
</div>
