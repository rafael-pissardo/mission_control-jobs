<div class="mc-table-wrapper">
  <table class="workers table mc-table mc-table--list mc-table--workers is-fullwidth">
    <thead>
      <tr>
        <th scope="col">
          <div class="mc-list-row mc-list-row--workers mc-list-row--header">
            <span class="mc-list-label">Worker</span>
            <span class="mc-list-label">Hostname</span>
            <span class="mc-list-label">Jobs</span>
            <span class="mc-list-label">Last heartbeat</span>
          </div>
        </th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "mission_control/jobs/workers/worker", collection: workers_page.records %>
    </tbody>
  </table>
</div>
